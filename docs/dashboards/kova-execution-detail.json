  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Execution Latency & Duration Distribution",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 201,
      "title": "Execution Duration Quantiles (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 Duration"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 Duration"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(execution_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 Duration"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 202,
      "title": "Execution Status Breakdown",
      "type": "piechart",
      "targets": [
        {
          "expr": "sum by (status) (increase(executions_completed_total[1h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 203,
      "title": "Product Graph & AI Reasoner Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 10 },
      "id": 204,
      "title": "AI Invocations by Capability & Acceptance",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (capability, accepted) (rate(ai_invocations_total[5m]))",
          "legendFormat": "{{capability}} (accepted: {{accepted}})"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 10 },
      "id": 205,
      "title": "Product Graph Entities by Type",
      "type": "bargauge",
      "targets": [
        {
          "expr": "sum by (entity_type) (product_graph_entities)",
          "legendFormat": "{{entity_type}}"
        }
      ]
    }
  ],
  "refresh": "10s",
