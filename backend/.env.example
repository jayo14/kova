DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kova_db
RUMPTYCLOUD_S3_ENDPOINT=https://s3.rumptycloud.com
RUMPTYCLOUD_ACCESS_KEY_ID=
RUMPTYCLOUD_SECRET_ACCESS_KEY=
STORAGE_BUCKET_PREFIX=kova
JWT_SECRET_KEY=your-super-secret-jwt-key
CREDENTIAL_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
REDIS_URL=rediss://default:redis_password@db-host.rumptycloud.com:30901/0
CELERY_BROKER_URL=rediss://default:redis_password@db-host.rumptycloud.com:30901/1
CELERY_RESULT_BACKEND=rediss://default:redis_password@db-host.rumptycloud.com:30901/2
ENVIRONMENT=development
DEBUG=true
# AI Intelligence Layer & Multi-Provider Failover Configuration
AI_PROVIDER=failover
AI_FAILOVER_ORDER=openrouter,gemini,groq,nvidia
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60.0
AI_MAX_OUTPUT_TOKENS=2000

# 1. Google Gemini (Single best model without intra-provider fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. OpenRouter (Free models router & free tier models in descending order of quality & speed)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3. Groq (Descending order of quality & speed)
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b,allam-2-7b
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. NVIDIA NIM (Descending order of quality & speed)
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning,nvidia/nemotron-3.5-lightning-30b-a3b,meta/llama-3.2-11b-vision-instruct,openai/gpt-oss-20b
NVIDIA_NIM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Generic / Fallback OpenAI-compatible endpoint (optional)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# AWS SES / Sessy Email Integration
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=production-ses
SES_FROM_EMAIL=

# Sentry Error Tracking & Performance Monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# Agent Loop Configuration
# When true, flows with an `objective` but no `steps` are executed via the
# AgentExecutor.run() loop instead of the deterministic FlowRunner.
# Requires: destructive-action allowlist (engine/safety/) and prompt-injection
# defense (engine/ai/prompt_sanitizer.py) to be active.
AGENT_EXECUTION_ENABLED=true
AGENT_EXECUTION_MAX_DURATION_SECONDS=600
