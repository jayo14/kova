user=
password=
host=
port=
dbname=

DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
ENVIRONMENT=
DEBUG=
STORAGE_BUCKET_PREFIX=
FRONTEND_URL=
JWT_SECRET_KEY=
CREDENTIAL_ENCRYPTION_KEY=
# AI Intelligence Layer & Multi-Provider Failover Configuration
AI_PROVIDER=failover
AI_FAILOVER_ORDER=openrouter,gemini,groq,nvidia
AI_TEMPERATURE=0.2
AI_TIMEOUT_SECONDS=60.0
AI_MAX_OUTPUT_TOKENS=2000

# 1. Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 2. OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3. Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 4. NVIDIA NIM
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Generic / Fallback OpenAI-compatible endpoint (optional)
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

